{
  "manifest_version": 3,
  "name": "ScreenShip",
  "version": "0.1.0",
  "description": "Free, local-first screenshot capture and annotation for Chrome.",
  "icons": {
    "16": "img/icon-16.png",
    "32": "img/icon-32.png",
    "48": "img/icon-48.png",
    "128": "img/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "tabs", "storage", "clipboardWrite"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "img/icon-16.png",
      "32": "img/icon-32.png"
    },
    "default_title": "ScreenShip",
    "default_popup": "src/popup/popup.html"
  }
}
